PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://showly:strong-password@127.0.0.1:5432/showly
JWT_SECRET=change-this-to-a-long-random-secret
UPLOAD_DIR=/var/www/uploads
PUBLIC_UPLOAD_BASE=/uploads
CORS_ORIGIN=https://showlytm.store,https://www.showlytm.store,https://direct.showlytm.store
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=

# ── Sentry (Error tracking) — opsiyonel ─────────────────────────────────────
# Boş bırakırsan Sentry pasif kalır (paket de yüklü değilse no-op).
# DSN'yi sentry.io > Project Settings > Client Keys'ten al.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
SENTRY_TRACES_SAMPLE_RATE=0.1
